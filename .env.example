# Copy to .env.local and fill in real values. NEVER commit .env.local — it's gitignored.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (for Drizzle migrations), from Supabase project settings
DATABASE_URL=

# --- Zoho (dedicated API Console client for THIS portal — do not reuse the D2C integration's) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=60046812966
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in

# --- Razorpay (payment links off invoices, not in-app checkout) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- SMS/WhatsApp OTP provider (pick one, fill in only what's used) ---
SMS_PROVIDER_API_KEY=

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
